NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required by /api/admin/cron/sweep (the automation sweep endpoint).
# Generate one (e.g. `openssl rand -hex 32`) and point your scheduler at that route
# with header: Authorization: Bearer <this value>. The route refuses all requests
# until this is set.
CRON_SECRET=
