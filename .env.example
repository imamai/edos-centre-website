NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required by /api/admin/cron/sweep (the automation sweep endpoint).
# Generate one (e.g. `openssl rand -hex 32`) and point your scheduler at that route
# with header: Authorization: Bearer <this value>. The route refuses all requests
# until this is set.
CRON_SECRET=

# Safaricom Daraja (M-Pesa STK Push). Register a sandbox app at
# developer.safaricom.co.ke to get MPESA_CONSUMER_KEY/SECRET. MPESA_SHORTCODE and
# MPESA_PASSKEY default to Safaricom's shared sandbox test app (174379) if you
# don't have your own — fine for testing, not for production. MPESA_CALLBACK_URL
# must be a public HTTPS URL Safaricom can reach (an ngrok tunnel while developing,
# your real domain once deployed) — it will not work with localhost.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-public-url.example.com/api/mpesa/callback
